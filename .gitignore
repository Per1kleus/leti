# --- Secrets and credentials (NEVER commit) ----------------------------------
# Written by the /settings command: IMAP/SMTP app passwords, Zoom/Teams client
# secrets, Alpaca API keys.
config/settings.local.yaml
# Playwright storage_state for Instagram/TikTok/Facebook - live session cookies.
data/social_sessions/
# Shared secret for the GUI's LAN access.
data/gui_remote_token.txt

# --- Runtime state and personal data -----------------------------------------
data/
logs/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- What the Windows launchers make ------------------------------------------
# The environment either launcher prepares in the project folder, and the output
# of launcher/build_exe.py. All of it is rebuildable from what IS committed, and
# leti_runtime\ in particular is a whole Python interpreter.
leti_env/
leti_runtime/
build/
dist/
*.spec.bak

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets and credentials (NEVER commit) ----------------------------------
# Written by the /settings command: IMAP/SMTP app passwords, Zoom/Teams client
# secrets, Alpaca API keys.
config/settings.local.yaml
# Playwright storage_state for Instagram/TikTok/Facebook - live session cookies.
data/social_sessions/
# Shared secret for the GUI's LAN access.
data/gui_remote_token.txt

# --- Runtime state and personal data -----------------------------------------
# data/* rather than data/: git does not look inside an ignored directory, so a
# blanket "data/" makes it impossible to un-ignore anything underneath it.
data/*
logs/

# ...except the wake-word model, which is not runtime state and not personal.
# It is a built artefact every installation needs and that no installation can
# produce for itself: training it takes PyTorch, a 200 MB text-to-speech model
# and hours of CPU (see training/wake_word/README.md). audio/wake_word.py looks
# for a custom model HERE and nowhere else, so shipping one means un-ignoring
# this one directory rather than inventing a second place to keep it.
!data/wake_words/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- What the release validation writes ---------------------------------------
# scripts/validate_windows_release.py records its verdicts and measurements here.
# They describe one machine's run and are regenerated by the next one.
validation_report.json
validation_report.txt

# --- What the Windows launchers make ------------------------------------------
# The environment either launcher prepares in the project folder, and the output
# of launcher/build_exe.py. All of it is rebuildable from what IS committed, and
# leti_runtime\ in particular is a whole Python interpreter.
leti_env/
leti_runtime/
build/
dist/
# The executable build_exe.py copies next to main.py, so the shortcuts find it.
# Root-anchored, so /Leti cannot match anything inside the project.
Leti.exe
/Leti
*.spec.bak

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
